---
import '../styles/global.css';
import Menu from '../components/Menu.astro';
const { frontmatter } = Astro.props;
const title = frontmatter.title;
---
<html>
    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    </head>
    <body>
        <Menu />
        <article>
            <h1>{title}</h1>
            <slot />
        </article>
    </body>
</html>