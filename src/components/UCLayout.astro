---
import '../styles/global.css';
import Menu from '../components/Menu.astro';
const { frontmatter } = Astro.props;
const title = frontmatter.title;
const categories = Array.isArray(frontmatter.categories)
  ? frontmatter.categories.join(', ')
  : frontmatter.categories;
---
<html>
    <head>
        <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
        <title>{title} - Strikin' Sixties</title>
		<link rel="icon" href="/StrikingSixties/mayday1969.jpg">
    </head>
    <body>
        <Menu />
        <article>
            <br><div class="tpheader"><h3>{categories}</h3>
            <h1>{title}</h1></div><br>
            <img src="/StrikingSixties/construction.png" alt="Revolutionary men at work sign" width="200" height="200">
            <h2>Sorry! Under construction</h2>
            <slot />
        </article>
    </body>
</html>